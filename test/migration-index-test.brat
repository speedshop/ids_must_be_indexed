@test "debug output works when enabled" {
  test_prepare

  create_schema '
  create_table "users", force: :cascade do |t|
    t.bigint "company_id"
    t.datetime "created_at", null: false
    t.datetime "updated_at", null: false
  end

  add_index "users", ["company_id"], name: "index_users_on_company_id"'

  create_migration "20240101000000_create_users.rb" '
class CreateUsers < ActiveRecord::Migration[7.2]
  def change
    create_table :users do |t|
      t.bigint :company_id
      t.timestamps
    end
    add_index :users, :company_id
  end
end'

  run env DEBUG=1 ./check_indexes.sh
  print_output
  assert_status 0
  match_output "Schema columns that need indexes"
}

@test "skips check when commit message contains [skip-index-check]" {
  test_prepare

  create_schema '
  create_table "users", force: :cascade do |t|
    t.bigint "company_id"
    t.datetime "created_at", null: false
    t.datetime "updated_at", null: false
  end'

  create_migration "20240101000000_create_users.rb" '
class CreateUsers < ActiveRecord::Migration[7.2]
  def change
    create_table :users do |t|
      t.bigint :company_id
      t.timestamps
    end
  end
end'

  git commit --amend -m "Add migration [skip-index-check]"

  run ./check_indexes.sh
  print_output
  assert_status 0
  match_output "Skipping index check"
}

@test "skips check when SKIP_INDEX_CHECK environment variable is set" {
  test_prepare

  create_schema '
  create_table "users", force: :cascade do |t|
    t.bigint "company_id"
    t.datetime "created_at", null: false
    t.datetime "updated_at", null: false
  end'

  create_migration "20240101000000_create_users.rb" '
class CreateUsers < ActiveRecord::Migration[7.2]
  def change
    create_table :users do |t|
      t.bigint :company_id
      t.timestamps
    end
  end
end'

  run env SKIP_INDEX_CHECK=1 ./check_indexes.sh
  print_output
  assert_status 0
  match_output "Skipping index check"
}

@test "skips check when GITHUB_PR_TITLE contains [skip-index-check]" {
  test_prepare

  create_schema '
  create_table "users", force: :cascade do |t|
    t.bigint "company_id"
    t.datetime "created_at", null: false
    t.datetime "updated_at", null: false
  end'

  create_migration "20240101000000_create_users.rb" '
class CreateUsers < ActiveRecord::Migration[7.2]
  def change
    create_table :users do |t|
      t.bigint :company_id
      t.timestamps
    end
  end
end'

  run env GITHUB_PR_TITLE="[skip-index-check] Update users table schema" ./check_indexes.sh
  print_output
  assert_status 0
  match_output "Skipping index check"
}

@test "handles UUID foreign keys" {
  test_prepare

  create_schema '
  create_table "products", force: :cascade do |t|
    t.uuid "category_id"
    t.datetime "created_at", null: false
    t.datetime "updated_at", null: false
  end'

  create_migration "20240101000000_create_products.rb" '
class CreateProducts < ActiveRecord::Migration[7.2]
  def change
    create_table :products do |t|
      t.uuid :category_id
      t.timestamps
    end
  end
end'

  run ./check_indexes.sh
  assert_status 1
  match_output "Missing index for foreign key column 'category_id' in table 'products'"
  match_output "Column type: uuid (Universally Unique Identifier)"
}

@test "passes when UUID has index" {
  test_prepare

  create_schema '
  create_table "products", force: :cascade do |t|
    t.uuid "category_id"
    t.datetime "created_at", null: false
